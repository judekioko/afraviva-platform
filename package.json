{
  "name": "afraviva-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/tailwind.build.css --watch",
    "video:studio": "remotion studio --config=video/remotion.config.ts video/src/index.ts",
    "video:render": "remotion render --config=video/remotion.config.ts video/src/index.ts Intro video/out/intro.mp4",
    "video:still": "remotion still --config=video/remotion.config.ts video/src/index.ts Intro video/out/intro.png --frame=60",
    "video:compositions": "remotion compositions --config=video/remotion.config.ts video/src/index.ts",
    "video:typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@remotion/cli": "^4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/player": "^4.0.541",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.14.1",
    "htmx.org": "^1.9.12"
  }
}
