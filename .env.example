SECRET_KEY=change-me-generate-a-real-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,afraviva.com,www.afraviva.com

# Local dev: leave DATABASE_URL unset to use SQLite.
# Truehost production: mysql://USER:PASSWORD@localhost:3306/DBNAME
DATABASE_URL=

# Truehost SMTP (use one of the existing @afraviva.com mailboxes)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.afraviva.com
EMAIL_PORT=587
EMAIL_HOST_USER=kiokoitdev@afraviva.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
ENQUIRY_NOTIFY_TO=kiokoitdev@afraviva.com

# Set to True only after every current staff account has enrolled a TOTP
# device under Admin > TOTP devices — turning this on first locks everyone
# without one out of the admin, with no self-recovery.
ADMIN_REQUIRE_2FA=False

# Minutes of admin inactivity before auto-logout (see ADMIN_IDLE_TIMEOUT_SECONDS
# in settings.py). Defaults to 900 seconds (15 min) if left unset.
ADMIN_IDLE_TIMEOUT_SECONDS=900
